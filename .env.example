# Pictaria Server configuration.
# Copy to .env and fill in the values for your setup.
#
# You need very little here: the server/storage settings and APP_PASSWORD are
# environment-only, but everything else (Immich connection, AI providers,
# voice, weather, backups) can also be set later from the web UI — no restart
# needed. Provider connections and model identifiers live under Settings → AI
# Providers; the active enrichment provider is selected on Enrich. A value
# saved in the UI overrides the environment until cleared.
# docs/CONFIGURATION.md is the complete reference.

# ---- Required: your Immich server (or set both in Settings → Server) ----
# HTTP and HTTPS are supported. Include https:// explicitly when using TLS;
# a scheme-less address defaults to HTTP. A trailing /api is removed.
IMMICH_BASE_URL=http://your-immich-host:2283
# Create under Immich → Account Settings → API Keys. Full access not needed:
# the exact least-privilege permission checklist is in docs/GETTING-STARTED.md.
IMMICH_API_KEY=
# Browser-facing Immich URL for deep links from the web UI (person pages,
# map, search). Only needed when it differs from IMMICH_BASE_URL; for example,
# the server may use internal HTTP while browsers use an HTTPS reverse proxy.
#IMMICH_PUBLIC_URL=

# ---- Authentication (password strongly recommended) ----
# Protects the API and web UI. The server refuses to start when this is blank
# unless the separate dangerous open-mode switch below is explicitly true.
APP_PASSWORD=
# Disables all Pictaria authentication. Anyone who can reach the server can
# browse photos and perform Immich-backed mutations. Leave false unless this
# is a deliberate, isolated-network deployment.
ALLOW_INSECURE_OPEN=false

# ---- Server ----
# Container image selected by docker-compose.yml. Tagged release files default
# to their matching versioned image tag; image tags omit the `v` used by Git
# release refs (`1.0.1` versus `v1.0.1`). Set this only for deliberate testing.
#PICTARIA_IMAGE_TAG=1.0.1
#HOST=0.0.0.0
#PORT=4080
#REQUEST_TIMEOUT_MS=60000
# Only when the server is reached exclusively through an HTTPS reverse proxy:
# marks the browser session cookie Secure (breaks plain-http:// login).
#SESSION_COOKIE_SECURE=true
# Public custom domain(s) allowed to serve the browser UI and issue session
# cookies, comma-separated as host[:port]. IPs, single-label LAN names,
# .local, .home.arpa, and Tailscale .ts.net names work without listing.
#BROWSER_ALLOWED_HOSTS=pictaria.example.com
# Comma-separated exact IPs or CIDRs for reverse proxies allowed to supply
# X-Forwarded-For. Leave blank for direct LAN/VPN access. Never use 0.0.0.0/0.
#TRUSTED_PROXY_IPS=127.0.0.1

# ---- Storage (defaults to ./data; the Docker image uses /data) ----
#DATABASE_PATH=data/enrichment.sqlite
#ALBUMS_DATA_FILE=data/smart-albums.json
#FRAME_DB_PATH=data/frame.db
#SETTINGS_PATH=data/settings.json
#WAKE_WORD_MODELS_DIR=data/wake-word-models
#INSIGHTS_DB_PATH=data/insights.sqlite

# ---- Backups (see docs/BACKUP.md) ----
# Automatic snapshots of the irreplaceable data files. Default destination is
# on the same disk — point BACKUP_DIR at a NAS mount or synced folder for
# real safety. Cadence and retention are also editable in Settings → Backups.
# BACKUP_DIR is environment-only. Bare Node uses the host path. Docker uses the
# container path of a separate bind mount (normally /backups), not the host path.
#BACKUP_DIR=
#BACKUP_ENABLED=true
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP=7

# ---- Enrich: AI photo analysis ----
# Off by default — each enrichment run sends the selected image rendition to
# its chosen model, which may be a cloud provider you configured.
#ENRICH_ENABLED=false
# Initial/infrastructure provider fallback. Choosing a provider on Enrich saves
# the active choice for future runs, visits, and restarts:
#   cloud_openai | local_lmstudio | local_ollama | openai_compatible | openrouter | cloud_ollama | venice
#DEFAULT_PROVIDER=cloud_openai
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-5.5
# LM Studio keeps model requests within infrastructure you operate. In Docker,
# 127.0.0.1 is the container itself — when LM Studio runs on the Docker host, use
# http://host.docker.internal:1234/v1 (Linux: add the extra_hosts line shown
# in docker-compose.yml) and enable "Serve on local network" in LM Studio.
#LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
#LMSTUDIO_MODEL=
# Generic OpenAI-compatible chat endpoint (for example llama.cpp). Include the
# API prefix in the URL; the bearer key is optional for keyless local servers.
#OPENAI_COMPATIBLE_BASE_URL=http://llama-host:8080/v1
#OPENAI_COMPATIBLE_MODEL=
#OPENAI_COMPATIBLE_API_KEY=
# Local Ollama = no third-party cloud model or API key. Same Docker host note as LM Studio
# (http://host.docker.internal:11434) — and Ollama itself must listen beyond
# localhost for a container to reach it (OLLAMA_HOST=0.0.0.0:11434, see
# Ollama's FAQ; that exposes an unauthenticated service to your network, so
# bind only as wide as needed). Model must be a vision model:
#OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434
#OLLAMA_LOCAL_MODEL=
# Only for local Ollama behind an authenticating proxy (adds a Bearer header):
#OLLAMA_LOCAL_API_KEY=
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=qwen/qwen3-vl-32b-instruct
#OLLAMA_API_KEY=
#OLLAMA_MODEL=qwen3.5:cloud
# Venice has no default model — pick one with vision + structured-output
# support (the AI referee also needs multi-image input), e.g. qwen3-vl-235b-a22b:
#VENICE_API_KEY=
#VENICE_MODEL=
# Immich rendition sent to the model: preview | thumbnail | original
#IMAGE_SOURCE=preview
# Optional operator-authored context saved with each run summary. Useful when
# comparing the same provider/model on different inference machines:
#INFERENCE_HOST_LABEL=M4 Mac mini · LM Studio
#MAX_FAILURES_PER_ASSET=2
# Copy AI captions into empty Immich descriptions or update Pictaria's earlier
# caption. A narrow concurrent-edit race remains; see docs/ENRICH.md.
#CAPTION_WRITEBACK=false

# ---- Curate: review queue behavior ----
# Collapse same-moment photos (bursts, re-shoots, duplicates) into Stacks:
#CURATE_BURST_GROUPING=true
# AI referee (gold star): compares each Stack side by side and marks a keeper
# suggestion. Needs enrichment enabled; configure the feature choice under
# Settings → Curate. Empty provider/model = follow Enrich and that provider's
# default model; the model must accept multiple images.
#CURATE_REFEREE_ENABLED=false
#CURATE_REFEREE_PROVIDER=
#CURATE_REFEREE_MODEL=

# ---- Voice: text-to-speech for Pictaria Frame ----
# TTS_PROVIDER: openai | elevenlabs (empty disables TTS)
# Voice/model/output choices live under Settings → Voice TTS. The ElevenLabs
# API key lives with the reusable credentials under Settings → AI Providers.
#TTS_PROVIDER=
#OPENAI_TTS_MODEL=gpt-4o-mini-tts
#OPENAI_TTS_VOICE=coral
#OPENAI_TTS_SPEED=1.17
#OPENAI_TTS_INSTRUCTIONS=
#ELEVENLABS_API_KEY=
#ELEVENLABS_VOICE_ID=
#ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# ---- Voice: spoken answers ----
# Spoken voice answers ("what's interesting about this photo", "tell me …").
# Interesting sends an Immich preview plus date, location, and filename to the
# chosen model independently of ENRICH_ENABLED.
# Any enrichment provider can answer them; it uses that provider's key and
# base URL from Settings → AI Providers. Choose these feature-specific models
# under Settings → Voice TTS. Prefer a cloud provider unless local inference is fast — the
# Pictaria Frame is silent until the answer lands. On Venice, choose a model whose
# model_spec.privacy is "private" for contractual zero retention.
# LM Studio cannot serve "interesting" outside macOS (WebP previews).
#VOICE_PROSE_PROVIDER=cloud_openai
# Empty = the model that provider is configured with under AI Providers.
#VOICE_INTERESTING_MODEL=
#VOICE_ASK_MODEL=
#VOICE_PROSE_TIMEOUT_MS=25000

# OpenAI's own per-command defaults, used when the VOICE_* models are empty.
#OPENAI_INTERESTING_MODEL=gpt-5.5
#OPENAI_ASK_MODEL=gpt-5.4-nano

# ---- Ambient: weather for the frame's ambient screen ----
# Default place when the frame doesn't pass one (any city name or US zip).
# Weather sends that place to Open-Meteo for geocoding, then requests the
# forecast with the resulting coordinates. No API key is required.
#WEATHER_DEFAULT_LOCATION=

# ---- Ambient: reverse geocoding for location display ----
# GEOCODING_PROVIDER: geoapify (empty disables reverse geocoding)
# Free key: create an account at https://www.geoapify.com/ — the free tier is plenty.
#GEOCODING_PROVIDER=
#GEOAPIFY_API_KEY=
# Cache resolved locations back into Immich asset metadata:
#IMMICH_METADATA_WRITEBACK=false

# ---- Albums: search paging against Immich ----
#ALBUMS_SEARCH_PAGE_SIZE=1000
#ALBUMS_MAX_SEARCH_PAGES=25

# ---- Insights: collection statistics (all computed locally by a daily sweep) ----
# How often the snapshot refreshes itself, in hours.
#INSIGHTS_REFRESH_HOURS=24
# Timeline trip detection: distance from home that counts as "away", quiet
# days tolerated inside one trip, and minimum away-days to call it a trip.
#INSIGHTS_TRIP_AWAY_KM=100
#INSIGHTS_TRIP_GAP_DAYS=3
#INSIGHTS_TRIP_MIN_DAYS=2
# The Favorites tile can count a tag instead of Immich favorites. Usually set
# from the UI (gear on the Favorites tile); these act as defaults.
#INSIGHTS_FAVORITES_TAG_ID=
#INSIGHTS_FAVORITES_TAG_VALUE=

# ---- Rarely needed (defaults are right for almost everyone) ----
# Enrichment taxonomy and prompt files:
#TAXONOMY_PATH=taxonomy/v1.json
#PROMPTS_DIR=prompts
#PROMPT_VERSION=v2
# LM Studio tuning ("none" removes the token cap; too low truncates JSON):
#LMSTUDIO_API_KEY=lm-studio
#LMSTUDIO_MAX_TOKENS=2400
#LMSTUDIO_TEMPERATURE=0
# Provider base URLs:
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OLLAMA_BASE_URL=https://ollama.com
#VENICE_BASE_URL=https://api.venice.ai/api/v1
# Voice tuning:
#OPENAI_TTS_FORMAT=mp3
#OPENAI_REQUEST_TIMEOUT_MS=30000
#OPENAI_INTERESTING_IMAGE_DETAIL=high
#OPENAI_INTERESTING_MAX_OUTPUT_TOKENS=420
#OPENAI_ASK_MAX_OUTPUT_TOKENS=600
#ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
#ELEVENLABS_REQUEST_TIMEOUT_MS=30000
# STT_PROVIDER is reserved; speech-to-text runs on-device in Pictaria Frame.
#STT_PROVIDER=
# Geocoding tuning:
#GEOCODING_TIMEOUT_MS=8000
#GEOCODING_COORDINATE_PRECISION=3
#IMMICH_LOCATION_METADATA_KEY=pictaria.locationEnrichment
# Insights sweep tuning:
#INSIGHTS_SWEEP_PAGE_SIZE=1000
#INSIGHTS_MAX_SWEEP_PAGES=1000
#INSIGHTS_TOP_PEOPLE=15
#INSIGHTS_MAX_TAG_COUNTS=250
#INSIGHTS_STAT_CONCURRENCY=4
