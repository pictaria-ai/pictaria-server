{
  "version": 6,
  "credentialBindings": [
    "server.immichApiKey",
    "enrich.openRouterApiKey",
    "enrich.openAiCompatibleApiKey",
    "enrich.ollamaApiKey",
    "enrich.veniceApiKey"
  ],
  "fields": [
    "server.immichBaseUrl|string|env=IMMICH_BASE_URL|maxLength=4000",
    "server.immichPublicUrl|string|env=IMMICH_PUBLIC_URL|maxLength=4000",
    "server.immichApiKey|string|env=IMMICH_API_KEY|secret|maxLength=4000",
    "server.openAiApiKey|string|env=OPENAI_API_KEY|secret|maxLength=4000",
    "enrich.enabled|boolean|env=ENRICH_ENABLED",
    "enrich.scheduledEnabled|boolean|env=ENRICH_SCHEDULE_ENABLED",
    "enrich.scheduledTime|string|env=ENRICH_SCHEDULE_TIME|maxLength=5",
    "enrich.scheduledTimeZone|string|env=ENRICH_SCHEDULE_TIME_ZONE|maxLength=100",
    "enrich.scheduledPhotoBudget|number|env=ENRICH_SCHEDULE_PHOTO_BUDGET|range=1..10000",
    "enrich.captionWriteback|boolean|env=CAPTION_WRITEBACK",
    "enrich.defaultProvider|string|env=DEFAULT_PROVIDER|enum=[\"local_lmstudio\",\"local_ollama\",\"openai_compatible\",\"cloud_ollama\",\"cloud_openai\",\"openrouter\",\"venice\"]|maxLength=4000",
    "enrich.imageSource|string|env=IMAGE_SOURCE|enum=[\"preview\",\"thumbnail\",\"original\"]|maxLength=4000",
    "enrich.inferenceHostLabel|string|env=INFERENCE_HOST_LABEL|maxLength=120",
    "enrich.openAiModel|string|env=OPENAI_MODEL|maxLength=4000",
    "enrich.lmStudioBaseUrl|string|env=LMSTUDIO_BASE_URL|maxLength=4000",
    "enrich.lmStudioModel|string|env=LMSTUDIO_MODEL|maxLength=4000",
    "enrich.openAiCompatibleBaseUrl|string|env=OPENAI_COMPATIBLE_BASE_URL|maxLength=4000",
    "enrich.openAiCompatibleApiKey|string|env=OPENAI_COMPATIBLE_API_KEY|secret|maxLength=4000",
    "enrich.openAiCompatibleModel|string|env=OPENAI_COMPATIBLE_MODEL|maxLength=4000",
    "enrich.ollamaLocalBaseUrl|string|env=OLLAMA_LOCAL_BASE_URL|maxLength=4000",
    "enrich.ollamaLocalModel|string|env=OLLAMA_LOCAL_MODEL|maxLength=4000",
    "enrich.openRouterApiKey|string|env=OPENROUTER_API_KEY|secret|maxLength=4000",
    "enrich.openRouterModel|string|env=OPENROUTER_MODEL|maxLength=4000",
    "enrich.ollamaApiKey|string|env=OLLAMA_API_KEY|secret|maxLength=4000",
    "enrich.ollamaModel|string|env=OLLAMA_MODEL|maxLength=4000",
    "enrich.veniceApiKey|string|env=VENICE_API_KEY|secret|maxLength=4000",
    "enrich.veniceModel|string|env=VENICE_MODEL|maxLength=4000",
    "enrich.systemPrompt|string|maxLength=20000",
    "enrich.userTemplate|string|maxLength=20000",
    "enrich.taxonomyJson|string|maxLength=200000",
    "curate.burstGrouping|boolean|env=CURATE_BURST_GROUPING",
    "curate.refereeEnabled|boolean|env=CURATE_REFEREE_ENABLED",
    "curate.refereeProvider|string|env=CURATE_REFEREE_PROVIDER|enum=[\"\",\"local_lmstudio\",\"local_ollama\",\"openai_compatible\",\"cloud_ollama\",\"cloud_openai\",\"openrouter\",\"venice\"]|maxLength=4000",
    "curate.refereeModel|string|env=CURATE_REFEREE_MODEL|maxLength=4000",
    "insights.favoritesTagId|string|env=INSIGHTS_FAVORITES_TAG_ID|maxLength=4000",
    "insights.favoritesTagValue|string|env=INSIGHTS_FAVORITES_TAG_VALUE|maxLength=4000",
    "insights.refreshIntervalHours|number|env=INSIGHTS_REFRESH_HOURS|range=1..720",
    "insights.tripAwayKm|number|env=INSIGHTS_TRIP_AWAY_KM|range=10..5000",
    "insights.tripGapDays|number|env=INSIGHTS_TRIP_GAP_DAYS|range=0..30",
    "insights.tripMinDays|number|env=INSIGHTS_TRIP_MIN_DAYS|range=1..30",
    "insights.locationGroups|json",
    "ambient.geocodingProvider|string|env=GEOCODING_PROVIDER|enum=[\"\",\"geoapify\"]|maxLength=4000",
    "ambient.geoapifyApiKey|string|env=GEOAPIFY_API_KEY|secret|maxLength=4000",
    "ambient.immichMetadataWriteback|boolean|env=IMMICH_METADATA_WRITEBACK",
    "voice.proseProvider|string|env=VOICE_PROSE_PROVIDER|enum=[\"cloud_openai\",\"local_lmstudio\",\"local_ollama\",\"openai_compatible\",\"cloud_ollama\",\"openrouter\",\"venice\"]|maxLength=4000",
    "voice.interestingModel|string|env=VOICE_INTERESTING_MODEL|maxLength=4000",
    "voice.askModel|string|env=VOICE_ASK_MODEL|maxLength=4000",
    "voice.openAiInterestingModel|string|env=OPENAI_INTERESTING_MODEL|maxLength=4000",
    "voice.openAiAskModel|string|env=OPENAI_ASK_MODEL|maxLength=4000",
    "voice.proseTimeoutMs|number|env=VOICE_PROSE_TIMEOUT_MS|range=2000..40000",
    "voice.interestingMaxOutputTokens|number|env=OPENAI_INTERESTING_MAX_OUTPUT_TOKENS|range=50..4000",
    "voice.askMaxOutputTokens|number|env=OPENAI_ASK_MAX_OUTPUT_TOKENS|range=50..4000",
    "voice.ttsProvider|string|env=TTS_PROVIDER|enum=[\"\",\"openai\",\"elevenlabs\"]|maxLength=4000",
    "voice.openAiTtsModel|string|env=OPENAI_TTS_MODEL|maxLength=4000",
    "voice.openAiTtsVoice|string|env=OPENAI_TTS_VOICE|maxLength=4000",
    "voice.openAiTtsSpeed|number|env=OPENAI_TTS_SPEED|range=0.5..2",
    "voice.openAiTtsInstructions|string|env=OPENAI_TTS_INSTRUCTIONS|maxLength=4000",
    "voice.elevenLabsApiKey|string|env=ELEVENLABS_API_KEY|secret|maxLength=4000",
    "voice.elevenLabsTtsModel|string|env=ELEVENLABS_TTS_MODEL|maxLength=4000",
    "voice.elevenLabsVoiceId|string|env=ELEVENLABS_VOICE_ID|maxLength=4000",
    "voice.elevenLabsOutputFormat|string|env=ELEVENLABS_OUTPUT_FORMAT|maxLength=4000",
    "prompts.interestingPrompt|string|maxLength=8000",
    "prompts.askPrompt|string|maxLength=8000",
    "backup.enabled|boolean|env=BACKUP_ENABLED",
    "backup.intervalHours|number|env=BACKUP_INTERVAL_HOURS|range=1..168",
    "backup.keep|number|env=BACKUP_KEEP|range=1..60",
    "support.supporterKey|string|secret|maxLength=4000"
  ]
}
